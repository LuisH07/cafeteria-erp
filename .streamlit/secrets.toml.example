# =============================================================================
# Template de Secrets - Cafeteria Grão do Agreste (ERP + BI)
# Copie este arquivo para `.streamlit/secrets.toml` (NUNCA versione secrets.toml)
# No Streamlit Community Cloud, cole este conteúdo em App Settings -> Secrets.
# =============================================================================

[database]
# Utilize a URL do Supabase Transaction/Session Pooler (IPv4 compatível):
# Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI (Pooler)
url = "postgresql+psycopg://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

[auth]
# Local:    http://localhost:8501/oauth2callback
# Produção: https://SEU-APP.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Gere uma string aleatória segura (ex.: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
cookie_secret = "SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE_32_CHARS"

[auth.google]
client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "SEU_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[auth_policy]
# Contas que recebem automaticamente perfil ADMIN no primeiro login
admin_emails = [
    "assuero.ximenes@ufape.edu.br",
    "seu.email@ufape.edu.br",
]
# Perfil padrão para outros usuários autenticados via Google
default_role = "GERENTE"
# Lista opcional para restringir login apenas a domínios específicos (vazio = qualquer conta Google)
allowed_domains = []
